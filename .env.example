# Copy this file to .env and fill in your keys:
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Groq: language model + speech-to-text — https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Serper: Google web search for the agent — https://serper.dev
SERPER_API_KEY=

# Chat model (must support tool calling). Faster alternative: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low | medium | high
GROQ_REASONING_EFFORT=low
# Speech-to-text model: whisper-large-v3-turbo | whisper-large-v3
GROQ_STT_MODEL=whisper-large-v3-turbo

# Voice output (Microsoft neural voices via edge-tts; list them with: edge-tts --list-voices)
TTS_VOICE=en-GB-RyanNeural
TTS_VOICE_UR=ur-PK-AsadNeural
TTS_RATE=+4%
TTS_PITCH=-6Hz

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
